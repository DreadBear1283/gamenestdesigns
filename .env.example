# ─── DATABASE ───────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string (URI format)
# Use the "Direct connection" string (not pooler) for migrations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Storage bucket name (created by sql/001_schema.sql)
SUPABASE_STORAGE_BUCKET=products

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Random 32+ character secret for JWT signing. Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# ─── ADMIN BOOTSTRAP ─────────────────────────────────────────────────────────
# On first server start, this account is created as admin automatically.
INITIAL_ADMIN_EMAIL=your_admin@email.com
INITIAL_ADMIN_PASSWORD=change_me_to_a_strong_password

# ─── STRIPE ──────────────────────────────────────────────────────────────────
# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── EMAIL (Resend) ──────────────────────────────────────────────────────────
# https://resend.com — create an API key for your domain
RESEND_API_KEY=re_...
EMAIL_FROM=GameNest Designs <orders@yourdomain.com>
OWNER_NOTIFICATION_EMAIL=your_email@example.com

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Twilio → Account → Account SID & Auth Token
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Twilio phone number (the number messages will come from)
TWILIO_PHONE_NUMBER=+1234567890
# Your phone number (where you'll receive order notifications)
OWNER_PHONE_NUMBER=+1234567890

# ─── ETSY (For importing reviews) ──────────────────────────────────────
# Etsy → Developer Dashboard → API keys
ETSY_SHOP_ID=your_shop_id
ETSY_API_KEY=your_api_key

# ─── APP ─────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically. Set APP_URL to your Railway public URL.
PORT=3000
APP_URL=https://your-app.up.railway.app
NODE_ENV=production
